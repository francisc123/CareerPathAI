# ─────────────────────────────────────────────
#  CareerPath AI — Environment Variables
#  Copy to .env and fill in your values
# ─────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=careerpath
POSTGRES_USER=careerpath_user
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://careerpath_user:change_me_strong_password@postgres:5432/careerpath

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# Kafka
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=careerpath-ai
KAFKA_GROUP_ID_PREFIX=careerpath

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_USE_SSL=false
MINIO_BUCKET_CVS_RAW=cvs-raw
MINIO_BUCKET_CVS_PROCESSED=cvs-processed
MINIO_BUCKET_COURSES=course-materials

# AI APIs
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# External APIs
# Leaving these as the "your-..." placeholders disables the integration
# gracefully (learning-path returns paths with no YouTube/Udemy resources)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-key-here
UDEMY_CLIENT_ID=your-udemy-client-id
UDEMY_CLIENT_SECRET=your-udemy-client-secret
YOUTUBE_API_KEY=your-youtube-data-api-key

# Gemini (used by every AI agent)
GEMINI_API_KEY=your-gemini-key-here

# Agent Orchestrator admin endpoints (HTTP Basic) — leave password BLANK to
# fail-closed in dev. /workflow/.../retry and /workflows/active require it.
ORCHESTRATOR_ADMIN_USER=admin
ORCHESTRATOR_ADMIN_PASSWORD=

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@careerpath.ai

# Web Push
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@careerpath.ai

# Service Ports (internal)
FRONTEND_PORT=3000
API_GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
CV_SERVICE_PORT=8002
JOB_SCRAPER_PORT=8003
NOTIFICATION_PORT=8004
AGENT_ORCHESTRATOR_PORT=8005
CV_ANALYZER_PORT=8006
LEARNING_PATH_PORT=8007
JOB_MATCH_PORT=8008
HR_INTERVIEW_PORT=8009
TECH_INTERVIEW_PORT=8010
